{
  "name": "ledger",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "dev:web": "pnpm --filter @ledger/web run dev",
    "dev:api": "pnpm --filter @ledger/api run dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ledger/database run generate",
    "db:migrate": "pnpm --filter @ledger/database run migrate",
    "db:seed": "pnpm --filter @ledger/database run seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
